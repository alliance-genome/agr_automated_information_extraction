TRAINING_DIR=/data/agr_document_classifier/training
CLASSIFICATION_DIR=/data/agr_document_classifier/to_classify
CLASSIFIERS_PATH=/data/agr_document_classifier
# Host paths for the two entity-extraction bind mounts. ENTITY_EXTRACTION_DIR is a
# subdirectory of ENTITY_EXTRACTION_PATH -- both are mounted, so keep them nested.
ENTITY_EXTRACTION_PATH=/data/agr_entity_extraction
ENTITY_EXTRACTION_DIR=/data/agr_entity_extraction/to_extract

ABC_API_SERVER=literature-rest.alliancegenome.org
CURATION_API_SERVER=https://curation.alliancegenome.org/api/

OKTA_API_AUDIENCE=api://default
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=
TMP_PATH=/usr/src/app/tmp
CLASSIFICATION_BATCH_SIZE=1000
AGR_CORPUS_DOWNLOAD_DIR=/usr/src/app/alliance_reference_files

DB_USER=postgres
DB_NAME=literature
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# WormBase Curation Status Page credentials
WB_USERNAME=your_username_here
WB_PASSWORD=your_password_here

# Entity extraction failure alerts are emailed to the scrum-blueteam-private Slack channel
# (Slack "send email to channel"). Uses agr_literature_service send_report over Gmail SMTP.
SENDER_EMAIL=
SENDER_PASSWORD=
REPLY_TO=
# Optional: override the channel's email-to-Slack address (defaults to the built-in one)
SLACK_CHANNEL_EMAIL=

# Centralized logging (Graylog). Container stdout/stderr is shipped by Docker's gelf
# log driver -- see the logging: block in docker-compose.yaml. These are read by
# Compose itself during interpolation, not by the container process.
# ENV_STATE separates dev from prod streams in Graylog: dev, stage or prod.
ENV_STATE=dev
GELF_ADDRESS=udp://agr-log-nlb-prod-2338fbd566b1dd01.elb.us-east-1.amazonaws.com:12201